{
  "name": "fancy-text-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run sync:engine && node --watch server.js",
    "start": "node server.js",
    "build": "npm run build:styles && npm run sync:engine && npm run build:js",
    "build:styles": "node scripts/build-fonts.js",
    "build:js": "node scripts/build-js.js",
    "sync:engine": "node scripts/sync-engine.js",
    "test": "node --test \"tests/**/*.test.js\""
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.1",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "firebase": "^13.0.0",
    "gsap": "^3.15.0",
    "helmet": "^7.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "supertest": "^7.0.0"
  }
}
