<%- include('../partials/head') %>
<nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> / <span aria-current="page"><%= page.title %></span></nav>
<article class="prose">
  <h1><%= page.title %></h1>
  <% page.body.forEach(function (p) { %><p><%= p %></p><% }) %>
  <% if (key === 'contact') { %>
    <% if (env.contactEmail) { %><p>Email <a href="mailto:<%= env.contactEmail %>"><%= env.contactEmail %></a>.</p>
    <% } else { %><p>No contact address is configured yet. Set <code>CONTACT_EMAIL</code> in the environment to show one here.</p><% } %>
  <% } %>
</article>
<%- include('../partials/foot', { withGenerator: false }) %>
