# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
PORT=3000
SITE_URL=http://localhost:3000
MAX_INPUT_LENGTH=5000
RATE_LIMIT_PER_MINUTE=60
# Shown on /contact only when set
CONTACT_EMAIL=

# M7 - open /admin?key=<this> on your deployment (optional but recommended)
ADMIN_KEY=

# M7 - optional model provider for the AI stylist (falls back to the local rules engine)
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# M6 - optional Firebase web config. Without these, /account stays in local mode
# (favourites and recents live in localStorage, no sign-in button).
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
